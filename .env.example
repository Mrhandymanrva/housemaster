# Railway sets DATABASE_URL and PORT for you when you attach a Postgres plugin.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/housemaster
PORT=8080

# Sign your own. Any long random string. Changing it signs everyone out.
JWT_SECRET=replace-me-with-64-random-characters

# There is no variable for the first login. A database with no users puts the
# sign-in screen into setup mode; you create the owner there, once.

# --- Inspection Support Network -------------------------------------------
# Ask ISN for an access key / secret access key pair on a dedicated
# integration user. Never a person's login: footprints are consumed per user,
# so sharing a login eats notifications other tools still need.
ISN_ACCESS_KEY=
ISN_SECRET_ACCESS_KEY=
