{
  "name": "housemaster-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev:server": "node --watch server/index.js",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web install --no-audit --no-fund && npm --prefix web run build",
    "start": "node server/index.js",
    "seed:demo": "node scripts/seed.js",
    "gen:demo-catalog": "node scripts/gen-demo-catalog.js",
    "postinstall": "npm --prefix web install --no-audit --no-fund"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  }
}
